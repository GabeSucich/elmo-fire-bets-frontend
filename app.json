{
  "expo": {
    "name": "Elmo Fire Bets",
    "slug": "frontend",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/elmofire.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabriel.elmofire",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/elmofire.png",
        "backgroundImage": "./assets/images/elmofire.png",
        "monochromeImage": "./assets/images/elmofire.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gabriel.elmofire"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/elmofire.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/elmo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elmo Fire Bets uses your photos so you can upload a screenshot of a parlay slip and correct picks from it."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "df67679d-f49b-4a64-a45e-70d8b5ca9fc9"
      }
    }
  }
}
