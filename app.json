{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/elmofire.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabriel.elmofire",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/elmofire.png",
        "backgroundImage": "./assets/images/elmofire.png",
        "monochromeImage": "./assets/images/elmofire.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gabriel.elmofire"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/elmofire.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/elmofire.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "df67679d-f49b-4a64-a45e-70d8b5ca9fc9"
      }
    }
  }
}
